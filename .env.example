# ==============================================================================
# PULSE BRIDGE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and frontend/.env.local and populate the secrets.
# NEVER commit .env or .env.local to version control!

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Central Database, Auth, Storage & pgvector)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Public Key (Safe for client-side queries permitted by RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service Role Secret (Backend ONLY — grants administrative DB & Storage access)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# AI & MULTIMODAL PROVIDERS
# ------------------------------------------------------------------------------
# Google Gemini API Key for Gemini 2.5/1.5 Flash Vision & text-embedding-004
GEMINI_API_KEY=your-gemini-api-key
# NVIDIA NIM API key for the doctor assistant and RAG chat
NVIDIA_NIMS_API_KEY=your-nvidia-nim-key
# NVIDIA API Catalog model used by the doctor assistant
NVIDIA_NIMS_CHAT_MODEL=deepseek-ai/deepseek-v4.1-flash
# Optional OpenRouter fallback for model diversity
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Must be prefixed with NEXT_PUBLIC_ for browser access)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
