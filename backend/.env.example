# ==============================================================================
# PULSE BRIDGE — BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Place these variables in backend/.env

# SUPABASE (Mandatory — Single Source of Truth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI & LLM PROVIDERS (Mandatory for live report explanation and doctor RAG)
GEMINI_API_KEY=
NVIDIA_NIMS_API_KEY=
NVIDIA_NIMS_CHAT_MODEL=deepseek-ai/deepseek-v4.1-flash
OPENROUTER_API_KEY=

# APPLICATION SETTINGS
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
